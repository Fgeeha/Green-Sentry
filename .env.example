# ============================================
# PROJECT CONFIGURATION
# ============================================
PROJECT_NAME="Green Sentry API"
VERSION="1.0.0"
DEBUG=false

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ============================================
# DATABASE
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=plant_disease

# ============================================
# REDIS / CACHE
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# GIGACHAT API
# ============================================
GIGACHAT_API_KEY=your-gigachat-api-key-here
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_TIMEOUT=30
GIGACHAT_MODEL=GigaChat-2

# ============================================
# ML MODEL
# ============================================
CV_MODEL_PATH=data/models/plant_disease_resnet50.pth
CONFIDENCE_THRESHOLD=0.7
MODEL_CACHE_SIZE=1

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png"]

# ============================================
# CACHE
# ============================================
CACHE_TTL=3600
DIAGNOSIS_CACHE_ENABLED=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=
ENABLE_METRICS=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# REGION DEFAULTS
# ============================================
DEFAULT_REGION=Москва
DEFAULT_CLIMATE=умеренно-континентальный

# ============================================
# EMAIL (Optional)
# ============================================
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@plantdisease.com
EMAILS_FROM_NAME="Plant Disease System"

# ============================================
# CORS
# ============================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost"]

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8000/api/v1